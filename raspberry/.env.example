# Copiar como raspberry/.env y cambiar las claves. raspberry/.env NO se sube al repo.
# Clave del usuario "nodealert" del broker (la usa Node-RED)
MQTT_NODERED_PASS=cambiar-esta-clave
# Clave del usuario "nodealert_esp32" del broker (la usa el firmware:
# tiene que ser igual a MQTT_PASS en firmware/control-luz/main/config_local.h)
MQTT_ESP32_PASS=cambiar-esta-otra-clave
