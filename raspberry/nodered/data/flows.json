    "z": "z_status",
    "name": "Process status",
    "func": "\nvar nid = msg.topic.split('/')[1];\nvar st = (msg.payload||'').toString().trim().toLowerCase();\nvar online = (st === 'online') ? 1 : 0;\nvar now = new Date().toISOString().replace('T',' ').split('.')[0];\nmsg.topic = \"INSERT INTO nodes(node_id,name,is_online,last_seen) SELECT '\"+nid+\"','\"+nid+\"',\"+online+\",'\"+now+\"' WHERE NOT EXISTS (SELECT 1 FROM nodes WHERE node_id='\"+nid+\"'); UPDATE nodes SET is_online=\"+online+\", last_seen='\"+now+\"' WHERE node_id='\"+nid+\"' AND hidden=0;\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
