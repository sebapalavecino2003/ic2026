    ],
    "z": "z_api",
    "name": "_api_nodes",
    "func": "var b=msg.req.body,nid=b.node_id;if(!nid){msg.statusCode=400;msg.payload={error:\"node_id is required\"};return msg;}var nm=(b.name||nid).replace(/'/g,\"''\");msg.topic=\"INSERT OR REPLACE INTO nodes(node_id,name,is_online,last_seen,hidden)VALUES('\"+nid+\"','\"+nm+\"',0,datetime('now'),0);INSERT OR IGNORE INTO node_config(node_id)VALUES('\"+nid+\"')\";return msg;",
