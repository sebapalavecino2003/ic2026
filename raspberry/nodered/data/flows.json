    "func": "var id=msg.req.params.node_id;msg.topic=\"SELECT n.*,t.temperature,t.gas,t.flame,t.temp_status,t.gas_status,t.flame_status,t.presencia,t.luz_ventana,t.luz_aula,t.temp_c,t.humedad,t.rele,t.timestamp as last_telemetry_ts FROM nodes n LEFT JOIN telemetry t ON t.id=(SELECT id FROM telemetry WHERE node_id='\"+id+\"'ORDER BY timestamp DESC LIMIT 1)WHERE n.node_id='\"+id+\"'AND n.hidden=0\";return msg;",
