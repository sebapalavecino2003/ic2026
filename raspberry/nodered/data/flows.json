    "z": "z_init",
    "name": "Create tables",
    "func": "msg.topic = `\nCREATE TABLE IF NOT EXISTS nodes (node_id TEXT PRIMARY KEY,name TEXT,is_online INTEGER DEFAULT 0,last_seen DATETIME,hidden INTEGER DEFAULT 0);\nCREATE TABLE IF NOT EXISTS telemetry (id INTEGER PRIMARY KEY AUTOINCREMENT,node_id TEXT,temperature REAL,gas INTEGER,flame INTEGER,temp_status TEXT,gas_status TEXT,flame_status TEXT,presencia INTEGER,luz_ventana REAL,luz_aula REAL,temp_c REAL,humedad REAL,rele INTEGER,timestamp DATETIME);\nCREATE INDEX IF NOT EXISTS idx_telemetry_node_ts ON telemetry(node_id, timestamp);\nCREATE TABLE IF NOT EXISTS node_config (node_id TEXT PRIMARY KEY,temperature_critical REAL DEFAULT 50,gas_warning INTEGER DEFAULT 3000,gas_critical INTEGER DEFAULT 4000,buzzer_enabled INTEGER DEFAULT 1,flame_critical_value REAL DEFAULT 500,flame_critical_severity TEXT DEFAULT 'critical',flame_critical_message TEXT DEFAULT 'Llama detectada',gas_critical_value REAL DEFAULT 2000,gas_critical_severity TEXT DEFAULT 'high',gas_critical_message TEXT DEFAULT 'Nivel de gas peligroso',temp_critical_value REAL DEFAULT 50,temp_critical_severity TEXT DEFAULT 'high',temp_critical_message TEXT DEFAULT 'Temperatura peligrosa',updated_at DATETIME);\n`;return msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
