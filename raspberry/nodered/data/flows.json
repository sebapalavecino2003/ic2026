  {
    "id": "n0018",
    "type": "function",
    "wires": [
      [
        "n0019"
      ]
    ],
    "z": "z_tele",
    "name": "Process telemetry",
    "func": "\nvar p = msg.payload, nid = msg.topic.split('/')[1], now = new Date().toISOString().replace('T',' ').split('.')[0], nm = p.device_id||nid;\nvar ts=(p.temp_status||''),gs=(p.gas_status||''),fs=(p.flame_status||'');\nfunction V(x){return (x==null)?'NULL':x;}\nvar temp=V(p.temperature),gas=V(p.gas_ppm),flame=V(p.flame);\nvar pres=V(p.presencia),lv=V(p.luz_ventana_lx),la=V(p.luz_aula_lx),tc=V(p.temp_c),hu=V(p.humedad_pct),rl=V(p.rele_canal1);\nmsg.topic=\"INSERT INTO nodes(node_id,name,is_online,last_seen)SELECT'\"+nid+\"','\"+nm+\"',1,'\"+now+\"'WHERE NOT EXISTS(SELECT 1 FROM nodes WHERE node_id='\"+nid+\"');UPDATE nodes SET is_online=1,last_seen='\"+now+\"',name=COALESCE(NULLIF(name,''),'\"+nm+\"')WHERE node_id='\"+nid+\"'AND hidden=0;INSERT INTO telemetry(node_id,temperature,gas,flame,temp_status,gas_status,flame_status,presencia,luz_ventana,luz_aula,temp_c,humedad,rele,timestamp)SELECT'\"+nid+\"',\"+temp+\",\"+gas+\",\"+flame+\",'\"+ts.replace(/'/g,\"''\")+\"','\"+gs.replace(/'/g,\"''\")+\"','\"+fs.replace(/'/g,\"''\")+\"',\"+pres+\",\"+lv+\",\"+la+\",\"+tc+\",\"+hu+\",\"+rl+\",'\"+now+\"'WHERE(SELECT hidden FROM nodes WHERE node_id='\"+nid+\"')=0;\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
